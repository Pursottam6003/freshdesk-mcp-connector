# Freshdesk domain name (e.g. acme or acme.freshdesk.com)
FRESHDESK_DOMAIN=acme.freshdesk.com

# Freshdesk API key from Profile Settings
FRESHDESK_API_KEY=your_freshdesk_api_key_here

# Operator gate for private conversations (true | false)
FRESHDESK_ALLOW_PRIVATE_NOTES=false

# Optional custom base URL (used for mock mode or local wiremock)
# FRESHDESK_BASE_URL=http://localhost:8080/mock-freshdesk